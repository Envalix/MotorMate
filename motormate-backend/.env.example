# ─────────────────────────────────────────────────────────────────────────────
# DATABASE  (Supabase PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Transaction Pooler — port 6543, used by the app at runtime.
# Source: Supabase Dashboard → Project Settings → Database → Connection string → Transaction pooler
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Note:   URL-encode special chars in your password: + → %2B  $ → %24  @ → %40
DATABASE_URL="postgresql://postgres.YOURREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# [REQUIRED] Direct connection — port 5432, used by Prisma migrations only.
# Source: Supabase Dashboard → Project Settings → Database → Connection string → Direct connection
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:PASSWORD@db.YOURREF.supabase.co:5432/postgres"

# ─────────────────────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] HTTP port the server listens on. Defaults to 3000.
PORT=3000

# [OPTIONAL] Runtime environment. Affects logging and error detail.
# Values: development | production | test
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Secret used to sign and verify JWT tokens.
# Generate with: openssl rand -base64 32
# Must be at least 32 random characters. Never reuse across environments.
JWT_SECRET=

# [OPTIONAL] Token expiry. Defaults to 7d.
# Accepts ms-style values: 60s | 15m | 1h | 7d | 30d
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH 2.0
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED for Google login] OAuth 2.0 client credentials.
# Source: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Format: GOOGLE_CLIENT_ID ends in .apps.googleusercontent.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [REQUIRED for Google login] Must be registered as an Authorised redirect URI
# in Google Cloud Console. Update to your production domain before deploying.
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ─────────────────────────────────────────────────────────────────────────────
# CLOUDINARY  (vehicle image & document storage)
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Your Cloudinary account identifiers.
# Source: Cloudinary Dashboard → top-right account menu → API Keys
# Format: CLOUD_NAME is a short lowercase slug (e.g. myapp)
#         API_KEY    is a numeric string     (e.g. 123456789012345)
#         API_SECRET is an alphanumeric string — treat like a password, never expose client-side
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# [REQUIRED] Names of unsigned upload presets created in Cloudinary settings.
# Source: Cloudinary Dashboard → Settings → Upload → Upload presets → Add upload preset
#   · Preset name must match exactly (case-sensitive).
#   · Signing mode must be set to "Unsigned" for client-side / server-direct uploads.
#   · Recommended folder per preset: motormate/vehicles  |  motormate/documents
# These values are safe to keep as defaults unless you rename the presets.
CLOUDINARY_VEHICLE_IMAGES_PRESET=vehicle_images
CLOUDINARY_VEHICLE_DOCS_PRESET=vehicle_documents

# ─────────────────────────────────────────────────────────────────────────────
# SENDGRID  (transactional email — password reset, notifications)
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED for email features] SendGrid API key with "Mail Send" permission.
# Source: SendGrid Dashboard → Settings → API Keys → Create API Key
#         Set permission: Restricted Access → Mail Send → Full Access
# Format: always starts with "SG."  (e.g. SG.xxxxxxxxxxxx.yyyyyyyyyyyy)
# Note:   The key is shown only once at creation — copy it immediately.
SENDGRID_API_KEY=REPLACE_ME

# [REQUIRED for email features] The "From" address on all outgoing emails.
# Must be verified in SendGrid before use:
#   SendGrid Dashboard → Settings → Sender Authentication → Single Sender Verification
# Use a real address you control (free-tier does not require a custom domain).
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# [OPTIONAL] Display name shown in the "From" field of outgoing emails.
# Defaults to MotorMate if not set.
SENDGRID_FROM_NAME=MotorMate
