# ─────────────────────────────────────────────────────────────────────────────
# DATABASE  (Supabase PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Transaction Pooler — port 6543, used by the app at runtime.
# Source: Supabase Dashboard → Project Settings → Database → Connection string → Transaction pooler
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Note:   URL-encode special chars in your password: + → %2B  $ → %24  @ → %40
DATABASE_URL="postgresql://postgres.YOURREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# [REQUIRED] Direct connection — port 5432, used by Prisma migrations only.
# Source: Supabase Dashboard → Project Settings → Database → Connection string → Direct connection
# Format: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:PASSWORD@db.YOURREF.supabase.co:5432/postgres"

# ─────────────────────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] HTTP port the server listens on. Defaults to 3000. Render uses 10000.
PORT=3000

# [OPTIONAL] Runtime environment. Affects CORS and error detail.
# Values: development | staging | production
NODE_ENV=development

# [REQUIRED in production] Allowed frontend origin for CORS.
# Dev: omit or set to * (main.ts allows all origins in dev mode)
# Staging: https://motormate-staging.vercel.app
# Prod:    https://motormate.vercel.app
FRONTEND_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Secret used to sign and verify JWT tokens.
# Generate with: openssl rand -base64 32
# Must be at least 32 random characters. Never reuse across environments.
JWT_SECRET=

# [OPTIONAL] Token expiry. Defaults to 7d.
# Accepts ms-style values: 60s | 15m | 1h | 7d | 30d
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH 2.0
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED for Google login] OAuth 2.0 client credentials.
# Source: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [REQUIRED for Google login] Must be registered as an Authorised redirect URI
# in Google Cloud Console. Update for each environment before deploying.
# Dev:     http://localhost:3000/api/auth/google/callback
# Staging: https://motormate-backend-staging.onrender.com/api/auth/google/callback
# Prod:    https://motormate-backend-prod.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ─────────────────────────────────────────────────────────────────────────────
# CLOUDINARY  (vehicle image & document storage)
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Your Cloudinary account identifiers.
# Source: Cloudinary Dashboard → top-right account menu → API Keys
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# [REQUIRED] Names of upload presets created in Cloudinary settings.
# Source: Cloudinary Dashboard → Settings → Upload → Upload presets
CLOUDINARY_VEHICLE_IMAGES_PRESET=vehicle_images
CLOUDINARY_VEHICLE_DOCS_PRESET=vehicle_documents

# ─────────────────────────────────────────────────────────────────────────────
# SMTP  (transactional email via nodemailer — provider-agnostic)
# Works with: Brevo, SendGrid, AWS SES, Mailgun, Gmail, etc.
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED for email features]
# Brevo example:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
# SendGrid:       SMTP_HOST=smtp.sendgrid.net     SMTP_PORT=587
# Gmail:          SMTP_HOST=smtp.gmail.com         SMTP_PORT=587
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME

# [REQUIRED for email features] The "From" address on all outgoing emails.
SMTP_FROM_EMAIL=noreply@yourdomain.com

# [OPTIONAL] Display name shown in the "From" field.
SMTP_FROM_NAME=MotorMate
